{
  "name": "noise",
  "productName": "Noise",
  "version": "1.0.12",
  "private": true,
  "description": "Minimal brown, pink, white, blue, and violet noise for focus.",
  "author": "James Furey (https://about.me/jamesfurey)",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/furey/noise",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/furey/noise.git"
  },
  "bugs": {
    "url": "https://github.com/furey/noise/discussions"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "test:e2e": "npm run build && node --test --test-concurrency=1 test/startup.test.mjs",
    "lint": "eslint .",
    "icons": "node scripts/make-icons.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win",
    "dist:linux": "npm run dist -- --linux"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright-core": "1.64.1",
    "vite": "7.3.7"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@^10": "^11.0.4",
      "@electron/universal": {
        "minimatch@^9": "^11.0.4"
      }
    }
  },
  "volta": {
    "node": "24.15.0"
  }
}
